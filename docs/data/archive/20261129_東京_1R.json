  "story": {
    "version": 2,
    "made_at": "2026-11-28T18:00",
    "sections": {
      "総括": [
        "結論：8番ダノンアイコニックの複勝。買うけど、金額は控えめにな。",
        "流れは平均やろ。力の差も小さいから、どれが来てもおかしない混戦や。",
        "○5番シュートザワークス（人気馬）は強さ・時計・上がりが全部2位以内。力はある。ただこの人気やと妙味はない。単勝5.8倍つかんと割に合わん。",
        "◎8番ダノンアイコニック（人気馬）は前走の相手が弱いが気になるけど、強さと時計の計算では上位。買い目に入っとる。",
        "印はないけど材料のある馬は、10番ディーヴァレギオン（前走は展開が向かんかった（スローを後ろから上がり上位））。こういう馬は材料が目立つぶん買われやすくて、材料ほどは走らん。",
        "◎8番ダノンアイコニックは締切には今より下がりそうや。配当は思ったより安くなる覚悟でな。"
      ],
      "展開": [
        "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
        "ペースはこのコースのいつもどおりやろ。",
        "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
      ],
      "データの外の馬": [
        "ダノンアイコニックのモレイラ騎手は、この1年JRAで18鞍しか乗っとらんけど、JRA通算428鞍で3着内58%。うちの騎手の強さは1年分で数えるから、平均くらいの扱いになっとる。"
      ],
      "3つの順位": [
        "シュートザワークスは強さ・時計・上がりが全部2位以内。6割近くが3着に来とる。"
      ],
      "人気の落とし穴": [
        "ゴーストミステリーは休み明け初戦の人気馬。休み明けの初戦は全体に人気ほど走らん。"
      ],
      "前哨戦の顔合わせ": [
        "11月15日の未勝利（東京芝1800m）から2頭: シュートザワークス2着（勝ち馬から0.1秒）、ロジグローリー6着（勝ち馬から0.7秒、4角で外を回して）。シュートザワークスが0.6秒先着しとる。",
        "10月3日の新馬（東京芝1800m）から2頭: セイウンウェルス10着（勝ち馬から3.6秒）、アイアンマン11着（勝ち馬から4.1秒）や。",
        "8月29日の新馬（札幌ダ1700m・稍重）から2頭: ゴーストミステリー7着（勝ち馬から1.0秒、2番手から・内を通って）、フクノブロッサム13着（勝ち馬から4.3秒）や。"
      ],
      "前走のレベル": [
        "ダノンアイコニックの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。",
        "ゴーストミステリーの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。",
        "アイデアルカットの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。",
        "セイウンウェルスの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。"
      ],
      "展開の向き不向き": [
        "ディーヴァレギオンの前走未勝利は、スローの流れを12番手から上がり3位で8着。展開が向かんかった。"
      ],
      "持ち時計": [
        "アイファーエリースはこのコースの持ち時計（1:38.9）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
        "コペルニクスの持ち時計（1:39.1）は出走馬で2番目。",
        "フェスティヴガッツの持ち時計（1:40.1）は出走馬で3番目。"
      ],
      "騎手と厩舎": [
        "フクノブロッサムの竹内正洋厩舎は休み明けより叩いてからの方がええ。"
      ],
      "調教": [
        "ダノンアイコニックは11/22の美浦坂路で終い11.8秒。この2週間に美浦坂路で追い切った9,132本の中で7番目（上位0.1%）、トップ20級。全体の時計も速いで。この級の終いの馬は3割半ばが3着に来とる。",
        "アイデアルカットは11/25に美浦坂路で52.0秒と全体の時計は上位。",
        "グラスリズムは11/23に美浦ウッドで65.2秒と全体の時計は上位。ただ終いは甘い。終いが甘いと並の調教と変わらん。"
      ],
      "前走との差": [
        "シュートザワークスは中1週や。",
        "ロジグローリーは中1週。過去の詰めた間隔では0-0-0-1や。",
        "ディーヴァレギオンは中1週や。"
      ]
    },
