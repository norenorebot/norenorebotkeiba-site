  "story": {
    "version": 2,
    "made_at": "2026-11-28T17:59",
    "sections": {
      "総括": [
        "結論：買わんでええ。見るだけのレースや。",
        "抜けた馬はおらんけど、強いて言えば○6番ハレムスビ（人気馬）。持ち時計が一番。",
        "◎8番ハイウェイワン（人気馬）は過去走に決め手がない。力比べで押し切れるかだけや。",
        "▲1番ヴィクトマインド（人気馬）は持ち時計が上位くらい。押さえ程度や。",
        "△3番リアルメッセージは1800mは初めてと材料は悪いけど、計算では上位や。人気がないなら押さえたい。"
      ],
      "展開": [
        "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
        "ペースはこのコースのいつもどおりやろ。",
        "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
      ],
      "見直し材料": [
        "エコロルークは前走重馬場で14着。良馬場に戻る今回は見直し。"
      ],
      "前哨戦の顔合わせ": [
        "同じ舞台の11月14日の未勝利（京都ダ1800m）から2頭: ハイウェイワン2着（勝ち馬から0.1秒、4番手から上がり2位）、サンフォルティス7着（勝ち馬から2.3秒）。ハイウェイワンが2.2秒先着しとる。",
        "11月14日の未勝利（福島ダ1700m）から2頭: フェイマスウルフ4着（勝ち馬から1.5秒、3〜4角で12番手から7番手まで捲って・4角で外を回して）、ギニー5着（勝ち馬から1.6秒、内を通って）。フェイマスウルフが0.1秒先着しとる。",
        "10月4日の新馬（京都ダ1400m）から2頭: ギニー9着（勝ち馬から1.8秒）、フェイマスウルフ10着（勝ち馬から2.1秒）や。"
      ],
      "前走のレベル": [
        "エコロルークの前走新馬からは、その後4頭が勝ち上がっとる。レベルの高い一戦や。",
        "ディヴィニダッドの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。"
      ],
      "前走の形": [
        "ハイウェイワンの前走未勝利は前半が緩んだ上がり勝負で2着や。",
        "ハレムスビの前走未勝利は前半から流れた消耗戦で2着や。",
        "アルギエバの前走新馬は前半から流れた消耗戦で5着や。"
      ],
      "持ち時計": [
        "ハレムスビはこのコースの持ち時計（1:54.1）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
        "ヴィクトマインドの持ち時計（1:54.7）は出走馬で2番目。",
        "ハイウェイワンの持ち時計（1:54.8）は出走馬で3番目。"
      ],
      "兄弟": [
        "ハイウェイワンは母シルバーポジーの子。兄弟にシルバーレシオ（ユニコーンS（G3）1着）がおる。"
      ],
      "騎手と厩舎": [
        "アルギエバの平田修厩舎は休み明けより叩いてからの方がええ。",
        "ギニーの国分優騎手は京都ダ1800m前後で3着内14%（ダ全体は9%）や。"
      ],
      "調教": [
        "バトルナイトは11/21に栗東ウッドで65.1秒と全体の時計は上位。"
      ],
      "前走との差": [
        "ハレムスビは中1週や。",
        "スマートプルーフは中1週や。",
        "リアルメッセージは前走から400mの距離延長や。"
      ],
      "斤量": [
        "スマートプルーフは前走から3kg減の52kgや。"
      ],
      "気になる点": [
        "リアルメッセージ: 1400mまでしか走っておらず、1800mは初めての距離や。"
      ]
    },
