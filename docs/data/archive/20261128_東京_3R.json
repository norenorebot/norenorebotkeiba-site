    "sections": {
      "総括": [
        "結論：どれが来てもおかしない。手を出さん方が賢い。まぁ強いて言うなら◎9番ドナリーや。",
        "◎9番ドナリーは過去走に決め手がない。力比べで押し切れるかだけや。",
        "○14番フォンテキアーラ（人気馬）は印は付いとるけど、前走の相手が弱い。過信は禁物や。",
        "▲6番ウイニングレイ（人気馬）は印は付いとるけど、過去走の材料は薄い。",
        "△13番コールセレスト（人気馬）は過去走に目立つ材料がない。力だけの評価や。"
      ],
      "展開": [
        "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
        "ペースはこのコースのいつもどおりやろ。",
        "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
      ],
      "前哨戦の顔合わせ": [
        "10月24日の未勝利（新潟ダ1800m・稍重）から2頭: ダブルブロッサム10着（勝ち馬から3.9秒）、ワンコール11着（勝ち馬から4.3秒）や。",
        "8月23日の新馬（新潟芝1600m）から2頭: ルーチェルナーレ7着（勝ち馬から0.7秒、スローを3番手で運んだ）、ランブリングガール8着（勝ち馬から0.8秒、4角9番手から上がり2位）や。",
        "7月18日の新馬（福島芝1800m）から2頭: ドナリー2着（勝ち馬から0.1秒、スローを1番手で運んだ）、ウイニングレイ8着（勝ち馬から1.2秒）。ドナリーが1.1秒先着しとる。"
      ],
      "前走のレベル": [
        "マリノシークレットの前走新馬からは、その後2頭が勝ち上がり（中京2歳S（G3）の勝ち馬も）。レベルの高い一戦や。",
        "フォンテキアーラの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。",
        "ロジヴィジョンの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。",
        "カーラベッリーナの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。"
      ],
      "前走の形": [
        "ドナリーの前走未勝利は前半から流れた消耗戦で2着や。",
        "フォンテキアーラの前走新馬は前半が緩んだ上がり勝負で2着や。",
        "コールセレストの前走新馬は前半が緩んだ上がり勝負で4着や。",
        "ロジヴィジョンの前走新馬は前半が緩んだ上がり勝負で2着や。"
      ],
      "展開の向き不向き": [
        "マリノシークレットの前走新馬は、スローの流れを10番手から上がり3位で10着。展開が向かんかった。"
      ],
      "持ち時計": [
        "マルガリートはこのコースの持ち時計（1:49.5）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
        "ランブリングガールの持ち時計（1:49.6）は出走馬で2番目。",
        "カーラベッリーナの持ち時計（1:51.3）は出走馬で3番目。"
      ],
      "主戦の行き先": [
        "フォンテキアーラの前走の鞍上ルメールは、今回コールセレストに乗る。"
      ],
      "血統": [
        "ファンタジーゲームの父ロゴタイプの産駒は、東京芝1800m前後ではほかの芝より走らへん。",
        "ウイニングレイの父ウインブライトの産駒は、東京芝1800m前後ではほかの芝より走らへん。",
        "マリノシークレットの父モーリスの産駒は、東京芝1800m前後がほかの芝より得意や。"
      ],
      "兄弟": [
        "コールセレストは母セレスタの子。兄弟にハーパー（クイーンS（G3）1着）がおる。",
        "コールセレストの兄弟は芝よりダートで走っている（芝4-3-6-29・ダ4-4-1-4）がおる。"
      ],
      "騎手と厩舎": [
        "マリノシークレットの武市康男厩舎は休み明けより叩いてからの方がええ。"
      ],
      "調教": [
        "フォンテキアーラは11/22に美浦坂路で53.2秒と全体の時計は上位。",
