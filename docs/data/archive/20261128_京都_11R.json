 "story": {
  "version": 2,
  "made_at": "2026-11-27T13:05",
  "sections": {
   "総括": [
    "結論：どれが来てもおかしない。手を出さん方が賢い。まぁ強いて言うなら◎3番ショウナンバトレニや。",
    "流れは平均やろ。力の差も小さい。",
    "▲10番ドラゴンバルド（人気馬）は強さ・時計・上がりが全部3位以内、持ち時計が一番。文句なしや。ただこの人気やと妙味はない。単勝6.8倍つかんと割に合わん。",
    "◎3番ショウナンバトレニは過去走に決め手はないし、計算でも横並びや。選ぶならこれやと思う。",
    "○9番ネーロノワール（人気馬）は印は付いとるけど、消しや。前走の相手が弱い、この時期の牝馬。",
    "△8番ノヴァヴェローチェ（人気馬）は過去走に目立つ材料がない。力だけの評価や。",
    "印はないけど材料のある馬は、1番アーケントレイル（この舞台で1-0-0-1）。こういう馬は材料が目立つぶん買われやすくて、材料ほどは走らん。"
   ],
   "展開": [
    "はっきりした逃げ馬はおらんで、逃げたこともある先行馬11サノノキセキの誰が行くかやな。",
    "ペースはこのコースのいつもどおりやろ。",
    "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
   ],
   "データの外の馬": [
    "ドラゴンバルドのモレイラ騎手は、この1年JRAで18鞍しか乗っとらんけど、JRA通算428鞍で3着内58%。うちの騎手の強さは1年分で数えるから、平均くらいの扱いになっとる。"
   ],
   "経歴・陣営": [
    "ゴールデンプロミス・アーケントレイルの矢作芳人厩舎は、このレースを2勝（最後は2023年のシンエンペラー）や。",
    "エトワールハマーの武豊騎手は、このレースを3勝（最後は2019年のマイラプソディ）や。",
    "ドラゴンバルドのモレイラ騎手は、このレースを2勝（最後は2023年のシンエンペラー）や。",
    "ドラゴンバルドのモレイラ騎手（ブラジル）は今回の来日（11月21日〜）で先週まで18戦3勝。JRA で G1 5勝（最後は2025年の皐月賞・ミュージアムマイル）や。",
    "シャローチャンプのC.デムーロ騎手（イタリア出身・フランスが拠点）は今回の来日（10月31日〜）で先週まで83戦20勝。JRA で G1 7勝（最後は2025年の有馬記念・ミュージアムマイル）や。",
    "ドラゴンバルドに乗るモレイラ騎手は、「マジックマン」と呼ばれるブラジルの騎手で、香港では1日8勝の記録がある。去年は桜花賞（エンブロイダリー）と皐月賞（ミュージアムマイル）を勝っとる。"
   ],
   "3つの順位": [
    "ドラゴンバルドは強さ・時計・上がりが全部3位以内。半分は3着に来とる。"
   ],
   "人気の落とし穴": [
    "ネーロノワールは牝馬。夏以外の牝馬は人気ほど走らん。",
    "ノヴァヴェローチェは休み明け初戦の人気馬。休み明けの初戦は全体に人気ほど走らん。"
   ],
   "前哨戦の顔合わせ": [
    "同じ舞台の10月10日の紫菊賞（1勝クラス）（京都芝2000m）から2頭: ドラゴンバルド2着（勝ち馬とタイム差なし、4番手から上がり2位）、ポルトブルー5着（勝ち馬から0.4秒、3番手から粘った・内を通って）。ドラゴンバルドが0.4秒先着しとる。",
    "8月9日の新馬（中京芝2000m）から2頭: ドラゴンバルド1着（2着に0.2秒差、スローを3番手で運んだ・上がり1位）、ショウナンバトレニ2着（勝ち馬から0.2秒、スローを3番手で運んだ・上がり1位）。ドラゴンバルドが0.2秒先着しとる。",
    "7月5日の新馬（小倉芝1800m・重馬場）から2頭: ポルトブルー1着（2着に0.6秒差、スローを1番手で運んだ・上がり2位）、シャローチャンプ3着（勝ち馬から0.6秒、4角で外を回して）。ポルトブルーが0.6秒先着しとる。"
   ],
   "前走のレベル": [
    "ネーロノワールの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。",
    "フェイマスジャズの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。"
   ],
   "前走の形": [
    "ショウナンバトレニの前走未勝利は中だるみからの上がり勝負で1着や。",
    "ネーロノワールの前走新馬は前半が緩んだ上がり勝負で1着や。",
    "ノヴァヴェローチェの前走新馬は中だるみからの上がり勝負で1着や。",
    "ゴールデンプロミスの前走未勝利は前半が緩んだ上がり勝負で1着や。"
   ],
   "展開の向き不向き": [
    "アーケントレイルの前走未勝利は超スローで、5着まで0.3秒差の団子。1着でも着順ほど力の差は出とらん。"
   ],
   "勝ち上がり": [
    "ショウナンバトレニは前走未勝利を1番人気で勝利（2着とタイム差なし）。未勝利からの昇級や。",
    "ネーロノワールは前走新馬を1番人気で勝利（2着に0.4秒差）。未勝利からの昇級や。",
    "ノヴァヴェローチェは前走新馬を3番人気で勝利（2着に0.6秒差）。未勝利からの昇級や。",
    "ゴールデンプロミスは前走未勝利を3番人気で勝利（2着に0.7秒差）。未勝利からの昇級や。",
    "アーケントレイルは前走未勝利を1番人気で勝利（2着に0.2秒差）。未勝利からの昇級や。",
    "エトワールハマーは前走未勝利を1番人気で勝利（2着に0.3秒差）。未勝利からの昇級や。",
    "シャローチャンプは前走未勝利を2番人気で勝利（2着に0.1秒差）。未勝利からの昇級や。",
    "サノノキセキは前走未勝利を2番人気で勝利（2着とタイム差なし）。未勝利からの昇級や。",
    "フェイマスジャズは前走新馬を4番人気で勝利（2着に0.2秒差）。未勝利からの昇級や。"
   ],
   "持ち時計": [
    "ドラゴンバルドはこのコースの持ち時計（1:59.4）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
    "ポルトブルーの持ち時計（1:59.8）は出走馬で2番目。",
    "ゴールデンプロミスの持ち時計（2:00.7）は出走馬で3番目。"
   ],
   "舞台の実績": [
    "アーケントレイルは京都芝1900〜2100mで1-0-0-1（未勝利1着）や。"
   ],
   "兄弟": [
    "サノノキセキは母メメクザリアーナの子。兄弟にサノノグレーター（ラジオNIKKEI賞（G3）1着）がおる。",
    "フェイマスジャズは母シルクヴィーナスの子。兄弟にエエヤン（ニュージーランドT（G2）1着）がおる。"
   ],
   "調教": [
    "エトワールハマーは11/25に栗東坂路で53.4秒と全体の時計は上位。ただ終いは甘い。終いが甘いと並の調教と変わらん。",
    "ショウナンバトレニは11/18に栗東坂路で53.9秒と全体の時計は上位。",
    "アーケントレイルは11/22に栗東坂路で53.9秒と全体の時計は上位。",
