 "story": {
  "version": 2,
  "made_at": "2026-11-27T13:06",
  "sections": {
   "総括": [
    "結論：買い目は出とらん。ただ力どおりに決まりそうなレースや。",
    "流れは平均やろ。力の差がはっきりしとるから、力どおりに決まる。3連単で買うなら、3頭の中で一番人気の馬を1着に置いた並びが割安や。人気薄が1着の並びは売れすぎや。",
    "11番カットソロは前走の負けは言い訳が立つ、詰めた間隔で実績あり。力はある。ただこの人気やと妙味はない。単勝14倍つかんと割に合わん。",
    "○9番クアッドフォルツァ（人気馬）はこの舞台で1-1-0-2、持ち時計が上位。力はある。ただこの人気やと妙味はない。単勝7.2倍つかんと割に合わん。",
    "◎12番グランドスウェル（人気馬）は持ち時計が上位、この舞台で0-0-2-1。信用してええ。",
    "△6番ジェネラスキングは前走の負けは言い訳が立つんやけど、2100mは初めて。疑ってかかりたい。"
   ],
   "展開": [
    "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
    "ペースはこのコースのいつもどおりやろ。",
    "流れが速くても遅くても、力と位置から見た上位の顔ぶれ（12グランドスウェル・9クアッドフォルツァ・8パンキー・1エマージェンス・7ゴールドビリーヴ）は変わりにくいわ。",
    "位置が読みにくい馬: 12グランドスウェル・9クアッドフォルツァ・3ガウラディスコ。"
   ],
   "データの外の馬": [
    "ガウラディスコのムーア騎手は、この1年JRAで乗っとらんけど、JRA通算155鞍で3着内40%。うちの騎手の強さは1年分で数えるから、平均くらいの扱いになっとる。"
   ],
   "人気の落とし穴": [
    "ガウラディスコは休み明け初戦の人気馬。休み明けの初戦は全体に人気ほど走らん。"
   ],
   "見直し材料": [
    "ジェネラスキングは前走重馬場で12着。良馬場に戻る今回は見直し。"
   ],
   "前哨戦の顔合わせ": [
    "同じ舞台の10月31日の1勝クラス（東京ダ2100m）から2頭: グランドスウェル3着（勝ち馬から1.3秒、4番手から上がり3位・内を通って）、クアッドフォルツァ5着（勝ち馬から1.5秒、スローを2番手で運んだ）。グランドスウェルが0.2秒先着しとる。",
    "同じ舞台の10月12日の1勝クラス（東京ダ2100m）から2頭: クアッドフォルツァ4着（勝ち馬から0.7秒、2番手から・内を通って）、エマージェンス7着（勝ち馬から1.4秒）。クアッドフォルツァが0.7秒先着しとる。",
    "9月12日の1勝クラス（中山ダ1800m・重馬場）から2頭: タイセツナヒ11着（勝ち馬から2.9秒）、ジェネラスキング12着（勝ち馬から3.0秒）や。"
   ],
   "前走のレベル": [
    "ゴールドビリーヴの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。"
   ],
   "前走の形": [
    "グランドスウェルの前走1勝クラスは前半が緩んだ上がり勝負で3着や。",
    "クアッドフォルツァの前走1勝クラスは前半が緩んだ上がり勝負で5着や。",
    "ゴールドビリーヴの前走未勝利は前半から流れた消耗戦で1着や。"
   ],
   "勝ち上がり": [
    "ゴールドビリーヴは前走未勝利を2番人気で勝利（2着に0.1秒差）。未勝利からの昇級や。"
   ],
   "巻き返し候補": [
    "ガウラディスコは前走1勝クラス7着（速い流れを2番手で受けて失速・内を通って）。その前に未勝利で1着があり、巻き返してもおかしない。",
    "ジェネラスキングは前走1勝クラス12着（重馬場）。その前に未勝利で1着があり、巻き返してもおかしない。",
    "カットソロは前走1勝クラス6着（芝ダが違った）。その前に未勝利で1着があり、巻き返してもおかしない。",
    "エマージェンスは前走1勝クラス6着（4角で外を回して）。その前に未勝利で2着（7番人気）があり、巻き返してもおかしない。"
   ],
   "持ち時計": [
    "ムーランブルーはこのコースの持ち時計（2:10.3）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
    "グランドスウェルの持ち時計（2:11.7）は出走馬で2番目。",
    "クアッドフォルツァの持ち時計（2:11.9）は出走馬で3番目。"
   ],
   "舞台の実績": [
    "クアッドフォルツァは東京ダ2000〜2200mで1-1-0-2（未勝利1着）や。",
    "グランドスウェルは東京ダ2000〜2200mで0-0-2-1（1勝クラス3着）や。",
    "ムーランブルーは東京ダ2000〜2200mで0-0-1-5（1勝クラス3着）や。"
   ],
   "流れの向き": [
    "ムーランブルーは速い流れで0-3-1-3、遅い流れで0-0-1-8。速くなってこその馬。"
   ],
   "回り": [
    "ジェネラスキングはダの左回りが初めて。",
    "タイセツナヒはダの左回りで0-0-0-3、反対回りで1-0-2-7や。"
   ],
   "血統": [
    "ムーランブルーの父ジャスタウェイの産駒は、東京ダ2100m前後ではほかのダより走らへん。"
   ],
   "兄弟": [
    "ムーランブルーの兄弟はダートより芝で走っている（芝2-1-3-9・ダ0-0-1-10）がおる。"
   ],
   "騎手と厩舎": [
    "パンキーの木幡巧騎手は東京ダ2100m前後で3着内27%（ダ全体は15%）や。",
    "ガウラディスコの高柳大輔厩舎は休み明けより叩いてからの方がええ。",
    "ゴールドビリーヴの鈴木慎太厩舎は休み明けより叩いてからの方がええ。"
   ],
   "調教": [
    "ムーランブルーは11/19に美浦坂路で54.0秒と全体の時計は上位。"
   ],
   "前走との差": [
    "カットソロは中1週。過去の詰めた間隔では1-0-1-0や。",
    "エマージェンスは中1週。過去の詰めた間隔では0-0-1-0や。",
    "アイルドゥレーヴェは中1週。過去の詰めた間隔では0-0-0-1や。",
    "ムーランブルーは連闘。過去の詰めた間隔では0-0-0-1や。",
    "カットソロは前走から500mの距離短縮や。"
   ],
   "2頭出し": [
    "久保田厩舎から2頭: ジェネラスキング・ムーランブルー。"
   ],
   "気になる点": [
