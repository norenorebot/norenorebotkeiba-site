  "story": {
    "version": 2,
    "made_at": "2026-11-13T15:03",
    "sections": {
      "総括": [
        "結論：どれが来てもおかしない。手を出さん方が賢い。",
        "流れは平均やろ。力の差も小さい。",
        "抜けた馬はおらんけど、強いて言えば◎6番ファーストアライヴ（人気馬）。強さ・時計・上がりが全部2位以内。",
        "○1番クロダテ（人気馬）は過去走に目立つ材料がない。力だけの評価や。",
        "▲10番ポッドトリガー（人気馬）は過去走に目立つ材料がない。力だけの評価や。",
        "△11番メイプルカモーンは鞍上強化くらい。押さえ程度や。",
        "印はないけど材料のある馬は、5番ミリオ（前走の相手が強い）。こういう馬は材料が目立つぶん買われやすくて、材料ほどは走らん。"
      ],
      "展開": [
        "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
        "ペースはこのコースのいつもどおりやろ。",
        "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
      ],
      "3つの順位": [
        "ファーストアライヴは強さ・時計・上がりが全部2位以内。6割近くが3着に来とる。"
      ],
      "人気の落とし穴": [
        "クロダテは休み明け初戦の人気馬。休み明けの初戦は全体に人気ほど走らん。"
      ],
      "見直し材料": [
        "マーゴットヴィムは前走不良馬場で9着。良馬場に戻る今回は見直し。"
      ],
      "前哨戦の顔合わせ": [
        "同じ舞台の10月25日の未勝利（東京ダ1600m・稍重）から2頭: コペルニクス4着（勝ち馬から1.2秒）、ロータスピーク5着（勝ち馬から1.4秒、3〜4角で6番手から2番手まで捲って・4角で外を回して）。コペルニクスが0.2秒先着しとる。",
        "10月10日の新馬（東京ダ1400m）から2頭: ポッドトリガー4着（勝ち馬から0.9秒、逃げて・内を通って）、コペルニクス9着（勝ち馬から1.9秒、4角で外を回して）。ポッドトリガーが1.0秒先着しとる。"
      ],
      "前走のレベル": [
        "ミリオの前走新馬からは、その後3頭が勝ち上がっとる。レベルの高い一戦や。",
        "アルティシモの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。"
      ],
      "持ち時計": [
        "コペルニクスはこのコースの持ち時計（1:40.4）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
        "ロータスピークの持ち時計（1:40.6）は出走馬で2番目。",
        "バーンズナイトの持ち時計（1:41.1）は出走馬で3番目。"
      ],
      "主戦の行き先": [
        "ポッドトリガーの前走の鞍上荻野極は、今回ファーストアライヴに乗る。"
      ],
      "鞍上": [
        "メイプルカモーンは西村淳に乗り替わり、初めてのコンビや。"
      ],
      "騎手と厩舎": [
        "ブラボーツーの遠藤騎手は東京ダ1600m前後では成績が落ちよる。",
        "ミリオの田中勝春厩舎は休み明けより叩いてからの方がええ。",
        "ロータスピークの石橋脩騎手は東京ダ1600m前後では成績が落ちよる。"
      ],
      "調教": [
        "キミヘノメロディーは11/11に美浦坂路で52.8秒と全体の時計は上位。",
        "マーゴットヴィムは11/11に栗東坂路で52.5秒と全体の時計は上位。",
        "エリステソーロは11/11に美浦ウッドで65.1秒と全体の時計は上位。"
      ],
      "前走との差": [
