 "story": {
  "version": 2,
  "made_at": "2026-11-13T15:03",
  "sections": {
   "総括": [
    "結論：買わんでええ。見るだけのレースや。",
    "抜けた馬はおらんけど、強いて言えば◎9番サウンドファイト（人気馬）。鞍上がこの舞台得意、時計は出とる。",
    "△2番マサノブルスカイは印は付いとるけど、鞍上がこの舞台苦手。過信は禁物や。",
    "○4番ハナナ（人気馬）は強さ・時計・上がりが全部2位以内。印どおり押さえてええ。",
    "▲13番レッドタイラント（人気馬）は過去走に目立つ材料がない。力だけの評価や。"
   ],
   "展開": [
    "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
    "ペースはこのコースのいつもどおりやろ。",
    "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
   ],
   "3つの順位": [
    "ハナナは強さ・時計・上がりが全部2位以内。6割近くが3着に来とる。"
   ],
   "人気の落とし穴": [
    "ハナナは牝馬。夏以外の牝馬は人気ほど走らん。",
    "レッドタイラントは休み明け初戦の人気馬。休み明けの初戦は全体に人気ほど走らん。"
   ],
   "見直し材料": [
    "リリーギャラクシーは前走重馬場で15着。良馬場に戻る今回は見直し。"
   ],
   "前哨戦の顔合わせ": [
    "10月31日の新馬（京都芝2000m）から3頭: マンハッタンモーン9着（勝ち馬から1.4秒）、トゥーリ10着（勝ち馬から1.6秒）、デルマクズリュウ13着（勝ち馬から2.2秒）や。"
   ],
   "前走のレベル": [
    "ハナナの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。"
   ],
   "前走の形": [
    "サウンドファイトの前走未勝利はロングスパート戦（残り1000mから11秒台が続く）で3着や。",
    "ハナナの前走未勝利は前半が緩んだ上がり勝負で2着や。",
    "レッドタイラントの前走新馬は中だるみからの上がり勝負で3着や。",
    "マサノブルスカイの前走未勝利は中だるみからの上がり勝負で5着や。"
   ],
   "血統": [
    "トゥーリの父ゴールドシップの産駒は、京都芝1800m前後ではほかの芝より走らへん。"
   ],
   "騎手と厩舎": [
    "マサノブルスカイの太宰騎手は京都芝1800m前後では成績が落ちよる。",
    "サウンドファイトの田山騎手は京都芝1800m前後が得意や。"
   ],
   "調教": [
    "サウンドファイトは11/5に栗東坂路で51.9秒と全体の時計は上位。"
   ],
   "前走との差": [
    "カールイメルは中1週や。",
    "ナムラサフランは中1週。過去の詰めた間隔では0-0-0-1や。",
    "マンハッタンモーンは中1週や。",
    "デルマクズリュウは中1週や。",
    "ロードフェルムは中1週や。"
   ]
