    "made_at": "2026-11-13T15:04",
    "sections": {
      "総括": [
        "結論：買わんでええ。見るだけのレースや。",
        "抜けた馬はおらんけど、強いて言えば◎15番トーセンマスラオ（人気馬）。強さ・時計・上がりが全部3位以内、時計は出とる。",
        "13番エクスマキナは消しや。前走の相手が弱い、この時期の牝馬。",
        "○2番ジオロジー（人気馬）は強さ・時計・上がりが全部3位以内、時計は出とる。印どおり押さえてええ。",
        "▲16番タピオラン（人気馬）は過去走に目立つ材料がない。力だけの評価や。",
        "△9番ムーンパッセは斤量2kg減くらい。押さえ程度や。",
        "印はないけど材料のある馬は、11番ダノンコレクト（前走の相手が強い）。こういう馬は材料が目立つぶん買われやすくて、材料ほどは走らん。",
        "割引は、10番クラオルグジェシダ（2000mは初めて）、1番ジュエルシップ（2000mは初めて）。"
      ],
      "展開": [
        "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
        "ペースはこのコースのいつもどおりやろ。",
        "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
      ],
      "3つの順位": [
        "ジオロジーは強さ・時計・上がりが全部3位以内。半分は3着に来とる。",
        "トーセンマスラオは強さ・時計・上がりが全部3位以内。半分は3着に来とる。"
      ],
      "人気の落とし穴": [
        "タピオランは牝馬。夏以外の牝馬は人気ほど走らん。",
        "クレイターレイクは牝馬。夏以外の牝馬は人気ほど走らん。",
        "エクスマキナは牝馬。夏以外の牝馬は人気ほど走らん。"
      ],
      "前哨戦の顔合わせ": [
        "10月25日の未勝利（新潟芝2000m・重馬場）から2頭: ロクメイカン3着（勝ち馬から0.9秒）、ムーンパッセ4着（勝ち馬から0.9秒、2番手から・内を通って）。2頭の差はほとんどあらへん。",
        "10月24日の新馬（新潟芝2000m）から2頭: タピオラン2着（勝ち馬から0.1秒、逃げて粘った・内を通って）、ジオロジー3着（勝ち馬から0.1秒、4番手から上がり1位・内を通って）。2頭の差はほとんどあらへん。",
        "10月18日の未勝利（新潟芝1800m）から2頭: クレイターレイク3着（勝ち馬から0.3秒、4角11番手から上がり2位）、ウィールズアップ5着（勝ち馬から0.4秒、4角11番手から上がり2位）。クレイターレイクが0.1秒先着しとる。"
      ],
      "前走のレベル": [
        "ダノンコレクトの前走新馬からは、その後5頭が勝ち上がっとる。レベルの高い一戦や。",
        "エクスマキナの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。",
        "ニシノカチオトコの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。",
        "コスモノーチラスの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。"
      ],
      "前走の形": [
        "トーセンマスラオの前走未勝利は前半から流れた消耗戦で2着や。",
        "エクスマキナの前走未勝利は中だるみからの上がり勝負で2着や。",
        "ニシノカチオトコの前走新馬は前半が緩んだ上がり勝負で5着や。"
      ],
      "回り": [
        "ウィールズアップは芝の右回りが初めて。",
        "クラオルグジェシダは芝の右回りが初めて。"
      ],
      "血統": [
        "クレイターレイクの父ダノンバラードの産駒は、福島芝2000m前後がほかの芝より得意や。"
      ],
      "兄弟": [
        "クレイターレイクは母オレゴンレディの子。兄弟にゴールデンハインド（フローラS（G2）1着）がおる。"
      ],
      "騎手と厩舎": [
        "ウィールズアップの横山琉騎手は福島芝2000m前後が得意や。"
      ],
      "調教": [
        "ロクメイカンは11/6に栗東坂路で51.9秒と全体の時計は上位。",
        "トーセンマスラオは11/11に美浦坂路で53.8秒と全体の時計は上位。",
        "ステラルミノーザは11/11に美浦ウッドで65.8秒と全体の時計は上位。ただ終いは甘い。終いが甘いと並の調教と変わらん。",
        "ジオロジーは11/11に美浦坂路で54.1秒と全体の時計は上位。",
        "ニシノカチオトコは11/11に美浦坂路で54.1秒と全体の時計は上位。"
      ],
      "前走との差": [
        "クラオルグジェシダは前走から600mの距離延長や。",
        "ジュエルシップは前走から400mの距離延長や。"
      ],
      "斤量": [
        "ムーンパッセは前走から3kg減の53kgや。"
      ],
      "2頭出し": [
        "馬主 ビッグレッドファーム から2頭: エクスマキナ・コスモノーチラス。"
      ],
      "気になる点": [
        "クラオルグジェシダ: 1600mまでしか走っておらず、2000mは初めての距離や。",
        "ジュエルシップ: 1600mまでしか走っておらず、2000mは初めての距離や。"
      ]
    },
