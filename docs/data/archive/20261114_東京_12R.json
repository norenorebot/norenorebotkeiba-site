 "story": {
  "version": 2,
  "made_at": "2026-11-13T15:03",
  "sections": {
   "総括": [
    "結論：買わんでええ。見るだけのレースや。",
    "5月23日の1勝クラス組は強いで。あの後4頭が勝ち上がっとる。そこで1着の12番ルナルーチェットは、計算では評価が低い。組の強さだけで飛びつくのは危ない。",
    "9番デイジーは前走1勝クラス勝ち、この舞台で1-1-0-1、手の合う騎手に戻る。文句なしや。",
    "8番ウィンターベル（人気薄）はキャリアの浅い古馬、鞍上強化、この舞台で1-0-0-2。人気はないけど力はある。",
    "◎1番ジーネキング（人気馬）は強さ・時計・上がりが全部2位以内、持ち時計が上位。信用してええ。",
    "穴なら2番スタニングヴュー（人気薄）。前走の負けは言い訳が立つ、距離短縮で実績あり。一発あってもおかしない。",
    "○4番ジーティーマン（人気馬）は強さ・時計・上がりが全部3位以内、持ち時計が上位。印どおり押さえてええ。",
    "▲11番エーデルヴェーグ（人気馬）は強さ・時計・上がりが全部3位以内。印どおり押さえてええ。",
    "△6番ノビリシマビジョンはキャリアの浅い古馬、距離短縮で実績あり。印どおり押さえてええ。",
    "印はないけど材料のある馬は、12番ルナルーチェット（この舞台で1-0-0-1）、10番ナハトナナレオン（前走1勝クラス勝ち）、5番コンテネレッツア（この舞台で1-2-2-1）。こういう馬は材料が目立つぶん買われやすくて、材料ほどは走らん。"
   ],
   "展開": [
    "はっきりした逃げ馬はおらんで、逃げたこともある先行馬8ウィンターベル・10ナハトナナレオンの誰が行くかやな。",
    "ペースはこのコースのいつもどおりやろ。",
    "流れが速くても遅くても、力と位置から見た上位の顔ぶれ（9デイジー・7マサノユニコーン・10ナハトナナレオン・1ジーネキング・11エーデルヴェーグ）は変わりにくいわ。",
    "位置が読みにくい馬: 12ルナルーチェット・5コンテネレッツア。"
   ],
   "3つの順位": [
    "ジーネキングは強さ・時計・上がりが全部2位以内。6割近くが3着に来とる。",
    "エーデルヴェーグは強さ・時計・上がりが全部3位以内。半分は3着に来とる。",
    "ジーティーマンは強さ・時計・上がりが全部3位以内。半分は3着に来とる。"
   ],
   "人気の落とし穴": [
    "ジーネキングは休み明け初戦の人気馬。休み明けの初戦は全体に人気ほど走らん。",
    "エーデルヴェーグは牝馬。夏以外の牝馬は人気ほど走らん。",
    "ノビリシマビジョンは牝馬。夏以外の牝馬は人気ほど走らん。",
    "ルナルーチェットは牝馬。夏以外の牝馬は人気ほど走らん。"
   ],
   "見直し材料": [
    "ノビリシマビジョンは4歳でまだ9戦。キャリアの浅い古馬は人気以上に走る。",
    "ウィンターベルは4歳でまだ7戦。キャリアの浅い古馬は人気以上に走る。"
   ],
   "前哨戦の顔合わせ": [
    "同じ舞台の10月11日の鷹巣山特別（2勝クラス）（東京芝1600m）から2頭: エーデルヴェーグ3着（勝ち馬から0.2秒、速い流れを3番手で受けて粘った）、シャンパンマーク9着（勝ち馬から0.8秒）。エーデルヴェーグが0.6秒先着しとる。",
    "同じ舞台の5月23日の1勝クラス（東京芝1600m）から2頭: ルナルーチェット1着（2着に0.5秒差、速い流れを3番手で受けて粘った）、スタニングヴュー9着（勝ち馬から1.1秒、内を通って）。ルナルーチェットが1.1秒先着しとる。",
    "同じ舞台の5月3日の2勝クラス（東京芝1600m）から2頭: コンテネレッツア2着（勝ち馬から0.4秒、逃げて粘った）、ウィンターベル6着（勝ち馬から1.0秒）。コンテネレッツアが0.6秒先着しとる。"
   ],
   "前走のレベル": [
    "ジーティーマンの前走野分特別（2勝クラス）は、その後に出た馬から勝ち馬がまだ出てへん。",
    "ルナルーチェットの前走御宿特別（2勝クラス）は、その後に出た馬から勝ち馬がまだ出てへん。"
   ],
   "前走の形": [
    "ジーネキングの前走摩周湖特別（2勝クラス）はロングスパート戦（残り1000mから11秒台が続く）で2着や。",
    "デイジーの前走1勝クラスは前半から流れた消耗戦で1着や。",
    "マサノユニコーンの前走2勝クラスは前半が緩んだ上がり勝負で4着や。"
   ],
   "勝ち上がり": [
    "デイジーは前走1勝クラスを3番人気で勝利（2着に0.1秒差）。1勝クラスからの昇級や。",
    "ナハトナナレオンは前走1勝クラスを7番人気で勝利（2着とタイム差なし）。1勝クラスからの昇級や。"
   ],
   "巻き返し候補": [
    "スタニングヴューは前走山中湖特別（2勝クラス）6着（稍重）。その前に古作特別（1勝クラス）で1着があり、巻き返してもおかしない。"
   ],
   "持ち時計": [
    "ルナルーチェットはこのコースの持ち時計（1:32.3）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
    "ジーネキングの持ち時計（1:32.4）は出走馬で2番目。",
    "ジーティーマンの持ち時計（1:32.7）は出走馬で3番目。"
   ],
   "舞台の実績": [
    "コンテネレッツアは東京芝1500〜1700mで1-2-2-1（1勝クラス1着）や。",
    "デイジーは東京芝1500〜1700mで1-1-0-1（1勝クラス1着）や。",
    "ルナルーチェットは東京芝1500〜1700mで1-0-0-1（1勝クラス1着）や。",
    "ウィンターベルは東京芝1500〜1700mで1-0-0-2（新馬1着）や。"
   ],
   "流れの向き": [
    "ジーネキングは遅い流れで0-1-1-0、速い流れで0-0-0-2。ゆったり流れてほしい馬。",
    "ウィンターベルは遅い流れで1-0-1-0、速い流れで0-0-0-3。ゆったり流れてほしい馬。",
    "シャンパンマークは遅い流れで2-0-0-2、速い流れで0-0-0-8。ゆったり流れてほしい馬。"
   ],
   "血統": [
    "スタニングヴューの父リアルスティールの産駒は、東京芝1600m前後がほかの芝より得意や。"
   ],
   "兄弟": [
    "エーデルヴェーグは母インナーアージの子。兄弟にブレイディヴェーグ（エリザベス女王杯（G1）1着）がおる。",
    "ルナルーチェットは母イルミナントの子。兄弟にライトクオンタム（シンザン記念（G3）1着）がおる。",
    "コンテネレッツアは母アドマイヤセプターの子。兄弟にデシエルト（中日新聞杯（G3）1着）がおる。",
    "シャンパンマークは母メモリアルライフの子。兄弟にシャンパンカラー（NHKマイルC（G1）1着）がおる。"
