 "story": {
  "version": 2,
  "made_at": "2026-11-15T00:43",
  "sections": {
   "総括": [
    "結論：買わんでええ。見るだけのレースや。",
    "はっきりした逃げ馬がおらん。前半はゆるそうや。前に行ける馬が残る。",
    "▲6番ナリタトップライトは強さ・時計・上がりが全部3位以内、持ち時計が上位。力はある。",
    "◎1番エフティヒア（人気馬）は過去走に決め手がない。力比べで押し切れるかだけや。",
    "○9番ホウオウビースト（人気馬）は過去走に目立つ材料がない。力だけの評価や。",
    "△4番コルソヴェローチェは過去走に目立つ材料がない。力だけの評価や。",
    "割引は、2番ロイヤルアイビス（2000mは初めて）、7番サイモンソレアード（2000mは初めて）。"
   ],
   "展開": [
    "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
    "このコースのいつもより、前半が緩みそうな顔ぶれ。前に行く馬が残りやすいで。",
    "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
   ],
   "3つの順位": [
    "ナリタトップライトは強さ・時計・上がりが全部3位以内。半分は3着に来とる。人気薄でもこの形は3回に1回は3着内や。"
   ],
   "見直し材料": [
    "ナショナルフラッグは前走重馬場で7着。良馬場に戻る今回は見直し。"
   ],
   "前哨戦の顔合わせ": [
    "同じ舞台の10月24日の未勝利（京都芝2000m・稍重）から3頭: ナリタトップライト2着（勝ち馬から0.2秒、スローを2番手で運んだ）、コルソヴェローチェ5着（勝ち馬から0.3秒、6番手から上がり3位）、テムルーラー9着（勝ち馬から0.7秒）や。",
    "11月1日の新馬（京都芝1600m）から2頭: ロイヤルアイビス12着（勝ち馬から1.6秒）、サイモンソレアード14着（勝ち馬から2.0秒）や。",
    "10月12日の新馬（京都芝1800m）から2頭: ホウオウビースト3着（勝ち馬から0.2秒、4番手から上がり2位・内を通って）、ナショナルフラッグ6着（勝ち馬から0.5秒）。ホウオウビーストが0.3秒先着しとる。"
   ],
   "前走の形": [
    "ナリタトップライトの前走未勝利は前半が緩んだ上がり勝負で2着や。",
    "コルソヴェローチェの前走未勝利は前半が緩んだ上がり勝負で5着や。"
   ],
   "展開の向き不向き": [
    "ナリタトップライトの前走未勝利は超スローで、5着まで0.3秒差の団子。2着でも着順ほど力の差は出とらん。",
    "コルソヴェローチェの前走未勝利は超スローで、5着まで0.3秒差の団子。5着でも着順ほど力の差は出とらん。"
   ],
   "持ち時計": [
    "テムルーラーはこのコースの持ち時計（2:01.9）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
    "エールヴォルの持ち時計（2:02.4）は出走馬で2番目。",
    "ナリタトップライトの持ち時計（2:02.8）は出走馬で3番目。"
   ],
   "鞍上": [
    "エフティヒアは岩田望に乗り替わり、初めてのコンビや。"
   ],
   "騎手と厩舎": [
    "ロイヤルアイビスの田山騎手は京都芝2000m前後が得意や。"
   ],
   "調教": [
    "ナショナルフラッグは11/11に栗東坂路で53.6秒と全体の時計は上位。"
   ],
   "前走との差": [
    "エールヴォルは中1週や。",
    "ロイヤルアイビスは中1週や。",
    "サイモンソレアードは中1週や。",
    "ロイヤルアイビスは前走から400mの距離延長や。",
    "サイモンソレアードは前走から400mの距離延長や。"
   ],
