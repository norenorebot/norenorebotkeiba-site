    "sections": {
      "総括": [
        "結論：どれが来てもおかしない。手を出さん方が賢い。",
        "流れは平均やろ。力の差も小さい。",
        "抜けた馬はおらんけど、強いて言えば4番スマートエール（人気薄）。前走の相手が強い。",
        "◎17番カツダルマ（人気馬）は過去走に決め手はないけど、計算では頭ひとつ抜けとる。信用するならこれやな。",
        "○8番アルテクィーン（人気馬）は前走の負けは言い訳が立つ。印どおり押さえてええ。"
      ],
      "展開": [
        "はっきりした逃げ馬はおらんで、逃げたこともある先行馬8アルテクィーン・18ミライノシャチョウの誰が行くかやな。",
        "ペースはこのコースのいつもどおりやろ。",
        "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
      ],
      "データの外の馬": [
        "ティンタアマレラのモレイラ騎手は、この1年JRAで乗っとらんけど、JRA通算410鞍で3着内59%。うちの騎手の強さは1年分で数えるから、平均くらいの扱いになっとる。"
      ],
      "人気の落とし穴": [
        "アルテクィーンは牝馬。夏以外の牝馬は人気ほど走らん。",
        "ジョリープリュムは牝馬。夏以外の牝馬は人気ほど走らん。",
        "ビバームスは牝馬。夏以外の牝馬は人気ほど走らん。"
      ],
      "前哨戦の顔合わせ": [
        "9月21日の未勝利（阪神芝1200m）から3頭: カツダルマ2着（勝ち馬から0.9秒）、ミライノシャチョウ9着（勝ち馬から1.4秒、逃げて）、メイショウレイナ12着（勝ち馬から2.1秒）や。",
        "10月12日の未勝利（京都芝1400m）から2頭: ティンタアマレラ4着（勝ち馬から0.5秒）、ジョリープリュム6着（勝ち馬から0.6秒、逃げて・内を通って）。2頭の差はほとんどあらへん。",
        "9月26日の未勝利（阪神芝1400m）から2頭: ヤマニンアルセド6着（勝ち馬から0.9秒）、スマートエール10着（勝ち馬から1.3秒）や。"
      ],
      "前走のレベル": [
        "スマートエールの前走未勝利からは、その後3頭が勝ち上がり（ファンタジーS（G3）の勝ち馬も）。レベルの高い一戦や。",
        "ヤマニンアルセドの前走未勝利からは、その後3頭が勝ち上がり（ファンタジーS（G3）の勝ち馬も）。レベルの高い一戦や。",
        "ティンタアマレラの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。",
        "スパイスオブライフの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。"
      ],
      "前走の形": [
        "カツダルマの前走未勝利はロングスパート戦（残り1000mから11秒台が続く）で2着や。",
        "アイファーラピッドの前走未勝利はロングスパート戦（残り1000mから11秒台が続く）で3着や。"
      ],
      "巻き返し候補": [
        "アルテクィーンは前走未勝利7着（芝ダが違った）。その前に未勝利で2着があり、巻き返してもおかしない。"
      ],
      "主戦の行き先": [
        "スピリッツの前走の鞍上武豊は、今回カツダルマに乗る。"
