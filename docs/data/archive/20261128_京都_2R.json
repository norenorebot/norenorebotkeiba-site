  "story": {
    "version": 2,
    "made_at": "2026-11-27T13:05",
    "sections": {
      "総括": [
        "結論：どれが来てもおかしない。手を出さん方が賢い。まぁ買うなら◎5番ベラジオアゲーラの複勝を持っとくのがええんちゃう？",
        "流れは平均やろ。力の差も小さい。",
        "◎5番ベラジオアゲーラ（人気馬）は強さ・時計・上がりが全部1位、持ち時計が上位。計算でも抜けとる。混戦の中でも信用してええ。",
        "○7番タイセイブリオン（人気馬）は過去走に目立つ材料がない。力だけの評価や。",
        "▲12番アブソリュートガイ（人気馬）は過去走に目立つ材料がない。力だけの評価や。",
        "△8番ハルカカナタは過去走に目立つ材料がない。力だけの評価や。",
        "印はないけど材料のある馬は、2番ウィモウェ（前走は展開が向かんかった（スローを後ろから上がり上位））。こういう馬は材料が目立つぶん買われやすくて、材料ほどは走らん。",
        "◎5番ベラジオアゲーラは勝つ確率も持ち時計も一番や。過去はこの形で3着内8割を超えとる。ただ当日、単勝が2.8倍より高くついとったら要注意や。配当が増えて得に見えるけど、過去はそういう時ほど来とらん。ほかの人が何か嫌う理由を知っとる合図や。その時はやめとき。"
      ],
      "展開": [
        "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
        "ペースはこのコースのいつもどおりやろ。",
        "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
      ],
      "データの外の馬": [
        "タイセイブリオンのモレイラ騎手は、この1年JRAで18鞍しか乗っとらんけど、JRA通算428鞍で3着内58%。うちの騎手の強さは1年分で数えるから、平均くらいの扱いになっとる。"
      ],
      "3つの順位": [
        "ベラジオアゲーラは強さ・時計・上がりが全部1位。この形の馬は3回に2回は3着に来とる。"
      ],
      "人気の落とし穴": [
        "ハルカカナタは牝馬。夏以外の牝馬は人気ほど走らん。",
        "リメンバーホープは牝馬。夏以外の牝馬は人気ほど走らん。"
      ],
      "前哨戦の顔合わせ": [
        "同じ舞台の11月1日の新馬（京都ダ1800m・稍重）から2頭: サイモンホライズン3着（勝ち馬から1.2秒、4角10番手から上がり2位・4角で外を回して）、アブソリュートガイ4着（勝ち馬から1.4秒、内を通って）。サイモンホライズンが0.2秒先着しとる。",
        "7月5日の新馬（小倉芝1800m・重馬場）から2頭: アシャカブラーヴ5着（勝ち馬から0.7秒、3〜4角で12番手から2番手まで捲って・4角で大外を回して）、ウィモウェ7着（勝ち馬から1.0秒）。アシャカブラーヴが0.3秒先着しとる。"
      ],
      "前走のレベル": [
        "ベラジオアゲーラの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。"
      ],
      "前走の形": [
        "ベラジオアゲーラの前走新馬は前半が緩んだ上がり勝負で2着や。",
        "タイセイブリオンの前走新馬は前半が緩んだ上がり勝負で4着や。",
        "アブソリュートガイの前走新馬は前半から流れた消耗戦で4着や。",
        "サイモンホライズンの前走新馬は前半から流れた消耗戦で3着や。"
      ],
      "展開の向き不向き": [
        "ウィモウェの前走未勝利は、スローの流れを11番手から上がり3位で8着。展開が向かんかった。"
      ],
      "持ち時計": [
        "ドリームアムニスはこのコースの持ち時計（1:53.5）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
        "ベラジオアゲーラの持ち時計（1:54.5）は出走馬で2番目。",
        "サイモンホライズンの持ち時計（1:54.6）は出走馬で3番目。"
      ],
      "兄弟": [
        "ウィモウェは母マシュマロの子。兄弟にハヤヤッコ（アルゼンチン共和国杯（G2）1着）がおる。"
      ],
      "調教": [
        "アシャカブラーヴは11/13に栗東坂路で53.0秒と全体の時計は上位。"
      ],
      "前走との差": [
        "サウンドホープは中1週や。",
        "リメンバーホープは中1週や。",
        "ドリームアムニスは中1週。過去の詰めた間隔では0-0-0-1や。",
        "シャルロットノエルは中1週や。",
        "ブラックブレットは前走から650mの距離延長や。"
      ],
      "気になる点": [
        "ブラックブレット: 1200mまでしか走っておらず、1800mは初めての距離や。"
      ]
