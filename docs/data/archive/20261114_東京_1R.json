  "story": {
    "version": 2,
    "made_at": "2026-11-13T15:03",
    "sections": {
      "総括": [
        "結論：買わんでええ。見るだけのレースや。",
        "◎7番ミヤルロワ（人気馬）は強さ・時計・上がりが全部1位、持ち時計が一番。文句なしや。ただこの人気やと妙味はない。単勝4.3倍つかんと割に合わん。",
        "○13番リーズメイリー（人気馬）は持ち時計が上位くらい。押さえ程度や。",
        "▲10番エコロブラン（人気馬）は強さ・時計・上がりが全部3位以内。印どおり押さえてええ。",
        "△1番リアスブルーは鞍上強化くらい。押さえ程度や。"
      ],
      "展開": [
        "はっきりした逃げ馬はおらんで、逃げたこともある先行馬12ワンキャンパスの誰が行くかやな。",
        "ペースはこのコースのいつもどおりやろ。",
        "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
      ],
      "3つの順位": [
        "ミヤルロワは強さ・時計・上がりが全部1位。この形の馬は3回に2回は3着に来とる。",
        "エコロブランは強さ・時計・上がりが全部3位以内。半分は3着に来とる。"
      ],
      "前哨戦の顔合わせ": [
        "同じ舞台の10月24日の新馬（東京ダ1400m・稍重）から2頭: リーズメイリー3着（勝ち馬から0.8秒、2番手から）、ニューイヤーズベル7着（勝ち馬から1.9秒）。リーズメイリーが1.1秒先着しとる。",
        "10月24日の未勝利（新潟ダ1800m・稍重）から2頭: ブルーグラビティ8着（勝ち馬から3.1秒）、ダブルブロッサム10着（勝ち馬から3.9秒）や。"
      ],
      "前走のレベル": [
        "エコロブランの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。",
        "ロイヤルグルーヴの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。",
        "サラサハヤブサの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。",
        "ラブシンフォニーの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。"
      ],
      "前走の形": [
        "ミヤルロワの前走新馬は前半が緩んだ上がり勝負で3着や。"
      ],
      "持ち時計": [
        "ミヤルロワはこのコースの持ち時計（1:25.8）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
        "リーズメイリーの持ち時計（1:26.0）は出走馬で2番目。",
        "ニューイヤーズベルの持ち時計（1:27.1）は出走馬で3番目。"
      ],
      "血統": [
        "ワンキャンパスの父ビッグアーサーの産駒は、東京ダ1400m前後ではほかのダより走らへん。"
      ],
      "兄弟": [
        "ミヤルロワは母ソフトライムの子。兄弟にペリエール（ユニコーンS（G3）1着）がおる。"
      ],
      "鞍上": [
        "リアスブルーは横山武に乗り替わり、初めてのコンビや。"
      ],
      "騎手と厩舎": [
        "ブルーグラビティの石橋脩騎手は東京ダ1400m前後では成績が落ちよる。",
        "サラサハヤブサの横山典騎手は東京ダ1400m前後が得意や。"
