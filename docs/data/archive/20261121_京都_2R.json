 "story": {
  "version": 2,
  "made_at": "2026-11-21T00:57",
  "sections": {
   "総括": [
    "結論：買わんでええ。見るだけのレースや。",
    "はっきりした逃げ馬がおらん。前半はゆるそうや。前に行ける馬が残る。",
    "◎9番スタニスラス（人気馬）は強さ・時計・上がりが全部2位以内、持ち時計が上位。力はある。ただこの人気やと妙味はない。単勝3.0倍つかんと割に合わん。",
    "▲5番アメリカンノヴァ（人気馬）は過去走に目立つ材料がない。力だけの評価や。",
    "△3番ジーティーアツモリは持ち時計が一番、血統的に合う舞台。印どおり押さえてええ。"
   ],
   "展開": [
    "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
    "このコースのいつもより、前半が緩みそうな顔ぶれ。前に行く馬が残りやすいで。",
    "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
   ],
   "データの外の馬": [
    "アメリカンノヴァのモレイラ騎手は、この1年JRAで乗っとらんけど、JRA通算410鞍で3着内59%。うちの騎手の強さは1年分で数えるから、平均くらいの扱いになっとる。"
   ],
   "3つの順位": [
    "スタニスラスは強さ・時計・上がりが全部2位以内。6割近くが3着に来とる。"
   ],
   "前哨戦の顔合わせ": [
    "同じ舞台の11月7日の新馬（京都ダ1800m）から3頭: スタニスラス2着（勝ち馬から0.4秒、スローを3番手で運んだ・上がり2位・4角で外を回して）、タガノスパーク4着（勝ち馬から1.7秒）、チャンピオンリング7着（勝ち馬から2.5秒）や。",
    "11月8日の新馬（東京ダ1600m）から2頭: アメリカンノヴァ4着（勝ち馬から0.7秒）、ジオイメル8着（勝ち馬から2.0秒、4角16番手から上がり1位）。アメリカンノヴァが1.3秒先着しとる。"
   ],
   "前走のレベル": [
    "スエヒロビリーブの前走新馬からは、その後1頭が勝ち上がり（デイリー杯2歳S（G2）の勝ち馬も）。レベルの高い一戦や。",
    "エボニーウイングの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。"
   ],
   "前走の形": [
    "スタニスラスの前走新馬は前半が緩んだ上がり勝負で2着や。",
    "アワジシマの前走未勝利は中だるみからの上がり勝負で3着や。",
    "タガノスパークの前走新馬は前半が緩んだ上がり勝負で4着や。",
    "レイテスツドリームの前走未勝利は前半から流れた消耗戦で5着や。"
   ],
   "持ち時計": [
    "ジーティーアツモリはこのコースの持ち時計（1:54.3）が出走馬で一番。持ち時計1位は4割近くが3着に来とる。",
    "ロゼブレイズの持ち時計（1:55.1）は出走馬で2番目。",
    "スタニスラスの持ち時計（1:55.4）は出走馬で3番目。"
   ],
   "血統": [
    "ジーティーアツモリの父ルーラーシップの産駒は、京都ダ1800m前後がほかのダより得意や。"
   ],
   "騎手と厩舎": [
    "レイテスツドリームの平田修厩舎は休み明けより叩いてからの方がええ。"
   ],
   "調教": [
    "エボニーウイングは11/11に栗東坂路で52.3秒と全体の時計は上位。",
    "レイテスツドリームは11/18に栗東坂路で53.7秒と全体の時計は上位。ただ終いは甘い。終いが甘いと並の調教と変わらん。"
   ],
   "前走との差": [
    "スタニスラスは中1週や。",
    "アメリカンノヴァは中1週や。",
    "タガノスパークは中1週や。",
    "ポッドベローチェは中1週や。",
    "ジオイメルは中1週や。"
   ]
  },
