 "story": {
  "version": 2,
  "made_at": "2026-11-13T15:03",
  "sections": {
   "総括": [
    "結論：買わんでええ。見るだけのレースや。",
    "はっきりした逃げ馬がおらん。前半はゆるそうや。前に行ける馬が残る。",
    "◎1番ヤマメゴリュウ（人気馬）は強さ・時計・上がりが全部2位以内、鞍上強化。力はある。",
    "11番サトノアニマ（人気馬）は前走の相手が弱い。過信は禁物や。",
    "9番サンタンヌは消しや。前走の相手が弱い、この時期の牝馬。",
    "○3番テンポアニマート（人気馬）は鞍上強化くらい。押さえ程度や。",
    "▲7番アイアムイガイニモは過去走に目立つ材料がない。力だけの評価や。",
    "△2番マイネルラビリンスは強さ・時計・上がりが全部3位以内。印どおり押さえてええ。",
    "割引は、5番フロックコート（2000mは初めて）、6番ジャスティンバルサ（2000mは初めて）。"
   ],
   "展開": [
    "はっきりした逃げ馬がおらん。前半は緩みやすい顔ぶれや。",
    "このコースのいつもより、前半が緩みそうな顔ぶれ。前に行く馬が残りやすいで。",
    "キャリアの浅い馬が多く、位置取りは読みにくいわ。"
   ],
   "3つの順位": [
    "ヤマメゴリュウは強さ・時計・上がりが全部2位以内。6割近くが3着に来とる。",
    "マイネルラビリンスは強さ・時計・上がりが全部3位以内。半分は3着に来とる。人気薄でもこの形は3回に1回は3着内や。"
   ],
   "人気の落とし穴": [
    "サンタンヌは牝馬。夏以外の牝馬は人気ほど走らん。"
   ],
   "見直し材料": [
    "マイネルラビリンスは前走重馬場で6着。良馬場に戻る今回は見直し。"
   ],
   "前哨戦の顔合わせ": [
    "10月25日の未勝利（新潟芝2000m・重馬場）から2頭: マイネルラビリンス6着（勝ち馬から1.4秒、4角13番手から上がり1位・4角で外を回して）、コスモフラムオット8着（勝ち馬から1.6秒、4角で外を回して）や。",
    "9月22日の新馬（中山芝2000m・重馬場）から2頭: テンポアニマート2着（勝ち馬から1.4秒、3番手から・上がり2位）、ヤマメゴリュウ5着（勝ち馬から2.0秒）。テンポアニマートが0.6秒先着しとる。",
    "7月19日の新馬（福島芝2000m）から2頭: サンタンヌ5着（勝ち馬から1.1秒、内を通って）、コスモフラムオット8着（勝ち馬から1.6秒）。サンタンヌが0.5秒先着しとる。"
   ],
   "前走のレベル": [
    "サトノアニマの前走新馬は、その後に出た馬から勝ち馬がまだ出てへん。",
    "サンタンヌの前走未勝利は、その後に出た馬から勝ち馬がまだ出てへん。"
   ],
   "前走の形": [
    "アイアムイガイニモの前走未勝利は前半が緩んだ上がり勝負で3着や。"
   ],
   "血統": [
    "アースグレイジングの父ブリックスアンドモルタルの産駒は、東京芝2000m前後がほかの芝より得意や。"
   ],
   "兄弟": [
    "サトノアニマは母ゼフィランサスの子。兄弟にディープボンド（阪神大賞典（G2）1着）がおる。",
    "ジャスティンバルサは母エリカブライトの子。兄弟にジャスティンシカゴ（セントライト記念（G2）1着）がおる。"
   ],
   "鞍上": [
    "ヤマメゴリュウは戸崎圭に乗り替わり、初めてのコンビや。",
    "テンポアニマートはルメールに乗り替わり、初めてのコンビや。"
   ],
   "騎手と厩舎": [
    "マイネルラビリンスの佐々木騎手は東京芝2000m前後では成績が落ちよる。",
    "シャインシュネルの石橋脩騎手は東京芝2000m前後では成績が落ちよる。",
    "アースグレイジングの木幡巧騎手は東京芝2000m前後では成績が落ちよる。"
   ],
   "調教": [
    "フロックコートは11/11に美浦坂路で54.0秒と全体の時計は上位。"
   ],
   "前走との差": [
    "ジャスティンバルサは中1週や。",
    "ジャスティンバルサは前走から600mの距離延長や。",
    "フロックコートは前走から400mの距離延長や。"
   ],
   "斤量": [
    "ダークアベンジャーは前走から3kg減の53kgや。"
   ],
   "2頭出し": [
    "馬主 ビッグレッドファーム から2頭: コスモフラムオット・ダークアベンジャー。"
   ],
   "気になる点": [
    "ジャスティンバルサ: 1400mまでしか走っておらず、2000mは初めての距離や。",
    "フロックコート: 1600mまでしか走っておらず、2000mは初めての距離や。"
   ]
